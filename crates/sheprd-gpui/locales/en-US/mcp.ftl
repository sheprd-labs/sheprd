# `sheprd mcp`, the Model Context Protocol server (`docs/mcp-plan.md`).

# Settings > General, under the MCP server switch while it is on.
mcp-settings-copy = MCP client setup
mcp-settings-copy-description = Copy the setting that starts Sheprd's MCP server, for Claude Desktop's claude_desktop_config.json or Cursor's mcp.json. Run `sheprd mcp config` for Claude Code and Codex.
mcp-settings-copy-button = Copy
mcp-settings-copy-off = Turn on MCP server above first.

# Shown over the terminal when an MCP client's request opened a dialog.
# $client is the name the client gave itself, such as Cursor.
mcp-dialog-requested = { $client } asked for this through MCP. Nothing changes until you confirm.
mcp-dialog-requested-unnamed = An MCP client asked for this. Nothing changes until you confirm.
