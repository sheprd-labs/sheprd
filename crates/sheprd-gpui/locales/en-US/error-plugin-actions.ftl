# Why a plugin action from a pane, tab, or workspace menu did not run.

error-plugin-actions-unsupported-host = Plugin actions need a local session or SSH host; custom socket endpoints are unsupported.
error-plugin-actions-development-session = Plugin actions are not available for development (--dev) sessions.
error-plugin-actions-missing-cli = Could not run the plugin action: the herdr CLI was not found on this host.
error-plugin-actions-script = Could not run the plugin action: { $error }
# $error is Herdr's own message.
error-plugin-actions-refused = Herdr refused the plugin action: { $error }
error-plugin-actions-decode = Could not run the plugin action: herdr returned unexpected output.
error-plugin-actions-unanswered = Could not run the plugin action: herdr did not answer.
error-plugin-actions-target-gone = The plugin action's pane, tab, or workspace no longer exists.
