{
  "id": "agent-chat",
  "feature": "ACP chats",
  "setup": [
    [
      "exec",
      "cd ~/code/forecast && git reset -q --hard && git clean -qfd; sed -i '' 's/^theme = .*/theme = \"Default\"/' ~/.config/herdr/config-gpui.local.toml; sleep 1"
    ],
    [
      "key",
      "escape"
    ],
    [
      "click",
      1600,
      1000
    ],
    [
      "key",
      "cmd+shift+n"
    ],
    [
      "wait",
      1.5
    ],
    [
      "type",
      "cd ~/code/forecast && clear"
    ],
    [
      "key",
      "return"
    ],
    [
      "wait",
      1.2
    ],
    [
      "exec",
      "cd ~/code/forecast && ~/Apps/Sheprd.app/Contents/MacOS/sheprd chat new gemini >/dev/null; sleep 4"
    ],
    [
      "click",
      1900,
      600
    ],
    [
      "key",
      "cmd+w"
    ],
    [
      "wait",
      1.5
    ],
    [
      "click",
      700,
      700
    ]
  ],
