{
  "id": "themes",
  "feature": "Hundreds of themes",
  "setup": [
    [
      "exec",
      "cd ~/code/forecast && git reset -q --hard && git clean -qfd; sed -i '' 's/^theme = .*/theme = \"Default\"/' ~/.config/herdr/config-gpui.local.toml; sleep 1"
    ],
    [
      "key",
      "escape"
    ],
    [
      "click",
      1600,
      700
    ],
    [
      "key",
      "ctrl+c"
    ],
    [
      "type",
      "clear; cd /System/Library; ls -G"
    ],
    [
      "key",
      "return"
    ],
    [
      "wait",
      1.5
    ]
  ],
  "segments": [
    {
      "actions": []
    },
    {
      "actions": [
        [
          "wait",
          0.8
        ],
        [
          "key",
          "cmd+shift+p"
        ],
        [
          "wait",
          0.7
        ],
        [
          "slowtype",
          "themes",
          0.05
        ],
        [
          "wait",
          0.5
        ],
        [
          "key",
          "return"
        ]
      ],
      "shortcut": "ctrl-shift-p"
    },
    {
      "actions": [
        [
          "wait",
          0.2
        ],
        [
          "key",
          "up"
        ],
        [
          "wait",
          0.25
        ],
        [
          "key",
          "up"
        ],
        [
          "wait",
          0.25
        ],
        [
          "key",
          "up"
        ],
        [
          "wait",
          1.3
        ],
        [
          "key",
          "up"
        ],
        [
          "wait",
          0.2
        ],
        [
          "key",
          "up"
        ],
        [
          "wait",
          0.2
        ],
        [
          "key",
          "up"
        ],
        [
          "wait",
          0.8
        ]
      ]
    },
    {
      "actions": [
        [
          "wait",
          0.4
        ],
        [
          "slowtype",
          "github l",
          0.02
        ],
        [
          "wait",
          0.9
        ],
        [
          "key",
          "return"
        ]
      ]
    },
    {
      "actions": []
    }
  ],
  "teardown": [
    [
      "key",
      "escape"
    ],
    [
      "exec",
      "cd ~/code/forecast && git reset -q --hard && git clean -qfd; sed -i '' 's/^theme = .*/theme = \"Default\"/' ~/.config/herdr/config-gpui.local.toml; sleep 1"
    ]
  ]
}
