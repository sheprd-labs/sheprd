{
  "id": "review-changes",
  "feature": "Review Changes",
  "setup": [
    [
      "exec",
      "cd ~/code/forecast && git reset -q --hard && git clean -qfd; sed -i '' 's/^theme = .*/theme = \"Default\"/' ~/.config/herdr/config-gpui.local.toml; sleep 1"
    ],
    [
      "exec",
      "printf '%s\\n' '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"session/prompt\",\"params\":{\"sessionId\":\"s1\"}}' | ~/.local/bin/gemini >/dev/null"
    ],
    [
      "key",
      "escape"
    ],
    [
      "click",
      1600,
      1000
    ],
    [
      "key",
      "cmd+shift+n"
    ],
    [
      "wait",
      1.5
    ],
    [
      "type",
      "cd ~/code/forecast && clear"
    ],
    [
      "key",
      "return"
    ],
    [
      "wait",
      1.2
    ]
  ],
