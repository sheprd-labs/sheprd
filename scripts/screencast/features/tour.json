      "cd ~/code/forecast && git reset -q --hard && git clean -qfd; for w in $(git worktree list --porcelain | awk '/^worktree /{print $2}' | tail -n +2); do git worktree remove --force \"$w\"; done; git branch -D json-output 2>/dev/null; cp ~/.config/herdr/screencast.toml ~/.config/herdr/config-gpui.local.toml; sleep 1"
